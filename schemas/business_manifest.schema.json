{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BusinessManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "business_id",
    "tables",
    "facts",
    "unresolved"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "business_id": {
      "type": "string",
      "minLength": 1
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/table"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    }
  },
  "$defs": {
    "references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_role",
        "source_files",
        "columns",
        "source_refs"
      ],
      "properties": {
        "table_role": {
          "enum": [
            "sales_records",
            "unit_conversions",
            "stock_snapshots",
            "purchase_lines",
            "price_history"
          ]
        },
        "source_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "columns": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_refs": {
          "$ref": "#/$defs/references"
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "value",
        "source_refs"
      ],
      "properties": {
        "fact_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "$ref": "#/$defs/references"
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "reason",
        "needed_evidence"
      ],
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "needed_evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
